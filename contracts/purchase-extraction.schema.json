{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closet Quest purchase extraction v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "items", "excluded_lines", "warnings"],
  "properties": {
    "schema_version": {"type":"string","const":"1"},
    "items": {"type":"array","maxItems":30,"items":{
      "type":"object","additionalProperties":false,
      "required":["source_line_ids","description","category","color","size","brand","quantity","review_reasons","evidence"],
      "properties":{
        "source_line_ids":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"string","pattern":"^L[1-9][0-9]*$"}},
        "description":{"type":"string","minLength":1,"maxLength":160},
        "category":{"type":"string","enum":["Top","Bottom","Dress","Shoes","Outerwear","Accessory"]},
        "color":{"type":["string","null"],"minLength":1,"maxLength":80},
        "size":{"type":["string","null"],"minLength":1,"maxLength":80},
        "brand":{"type":["string","null"],"minLength":1,"maxLength":80},
        "quantity":{"type":["integer","null"],"minimum":1,"maximum":10},
        "review_reasons":{"type":"array","maxItems":10,"items":{"type":"string","minLength":1,"maxLength":300}},
        "evidence":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["field","line_id","quote"],"properties":{"field":{"enum":["description","category","color","size","brand","quantity"]},"line_id":{"type":"string"},"quote":{"type":"string","minLength":1,"maxLength":500}}}}
      }
    }},
    "excluded_lines":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["line_id","reason"],"properties":{"line_id":{"type":"string"},"reason":{"enum":["header","shipping","tax","discount","non_clothing","ambiguous","instruction","return"]}}}},
    "warnings":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":300}}
  }
}
