# Server only. Copy to .env.local, fill in approved credentials, then restart.
# Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
# Profiles are Fast=gpt-6-luna, Balanced=gpt-6.1-sol, Deep=gpt-6-astra.
# Optional per-task model overrides (leave blank to use the chosen profile).
CLOSET_OPENAI_RECOGNITION_MODEL=
CLOSET_OPENAI_RECOMMENDATION_MODEL=
# Optional document embeddings; selected explicitly in the app.
CLOSET_OPENAI_EMBED_MODEL=text-embedding-3-small
# CLOSET_OPENAI_MODEL is still accepted as a legacy override for both tasks.
DEPOP_API_KEY=
# staging for Depop test keys; production for approved live keys
DEPOP_ENVIRONMENT=staging

# Hosted pilot only. Leave blank for local loopback use.
# Set these privately in the hosting service; never use VITE_ or commit real values.
CLOSET_PUBLIC_ORIGIN=
CLOSET_SESSION_SECRET=
CLOSET_ACCESS_USERS=

# Account mode: both values enable Supabase Auth, database RLS and private photos.
# Use a publishable/anon key, NEVER a service_role or sb_secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Smart purchase import: disabled unless explicitly enabled.
# Local mode needs Ollama on the API host. Hosted mode uses worker after migrations 003-005.
CLOSET_PURCHASE_IMPORTS=0
CLOSET_IMPORT_PROVIDER=local
CLOSET_IMPORT_MODEL=qwen3-vl:4b-instruct-q4_K_M
# Hosted mode uses worker, a durable Supabase queue and the explicit rules fallback.
# Keep the scoped worker credential in an ignored file on the inference machine.
CLOSET_WORKER_CONFIG=.local-data/deployment/purchase-worker.json
